{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "HomeAssistant": {
    "Enabled": true,
    "Url": "http://hab.home:8123/",
    "TokenFile": "C:\\ProgramData\\CherishedPhotos\\ha.txt",
    "InsideTemperature": "sensor.temperaturebath",
    "InsideHumidity": "sensor.temperatureoffice",
    "OutsideTemperature": "sensor.radiant_slab_battery_level",
    "OutsideHumidity": "sensor.temperatureplayroom",
    "RequestTimeoutSeconds": 15,
    "HeartbeatIntervalSeconds": 30
  },
  "PoolSettings": {
    "PoolFolder": "C:\\temp",
    "PoolFilter": ".jpg,.jpeg",
    "SlideshowIntervalMs": 3000,
    "RefreshIntervalMs": 3600000,
    "StateFolder": ""
  },
  "Kestrel": {
    "Endpoints": {
      "Http": {
        "Url": "http://localhost:8083"
      }
    }
  }
}
